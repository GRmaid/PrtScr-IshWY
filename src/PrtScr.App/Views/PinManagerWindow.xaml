<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PrtScr.App.Views.PinManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PrtScr.App.Views">

    <Grid x:Name="RootGrid" Padding="18" RowSpacing="12" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Grid.Resources>
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="屏幕贴图管理" FontSize="22" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="所有贴图都在这里；被隐藏或点击穿透的贴图可以从这里恢复。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="全部隐藏" Click="HideAll_Click" />
                    <Button Content="全部显示" Click="ShowAll_Click" />
                </StackPanel>
                <Border
                    Width="1"
                    Height="20"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button
                    Content="全部关闭"
                    AutomationProperties.Name="关闭全部贴图窗口（不删除图片文件）"
                    Click="CloseAll_Click"
                    Style="{StaticResource DangerButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <GridView
                x:Name="PinGrid"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="PinGrid_ItemClick">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="264" ItemHeight="244" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:PinCardView">
                        <Grid
                            Width="252"
                            Height="232"
                            Padding="10"
                            RowSpacing="6"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="108" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Padding="6">
                                <Image
                                    Source="{x:Bind Thumbnail}"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <Grid Grid.Row="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock
                                        Text="{x:Bind Caption}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Detail}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind StateText}"
                                        FontSize="11"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Content="恢复"
                                    Padding="7,3"
                                    MinWidth="0"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind RestoreVisibility}"
                                    Click="RestoreCard_Click" />
                            </Grid>

                            <Grid Grid.Row="2" ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Content="复制"
                                    Padding="4,3"
                                    MinWidth="0"
                                    FontSize="11"
                                    AutomationProperties.Name="{x:Bind CopyCaption}"
                                    Click="CopyCard_Click" />
                                <Button
                                    Grid.Column="1"
                                    Content="另存"
                                    Padding="4,3"
                                    MinWidth="0"
                                    FontSize="11"
                                    AutomationProperties.Name="{x:Bind SaveCaption}"
                                    Click="SaveCard_Click" />
                                <Button
                                    Grid.Column="2"
                                    Content="识别"
                                    Padding="4,3"
                                    MinWidth="0"
                                    FontSize="11"
                                    AutomationProperties.Name="{x:Bind OcrCaption}"
                                    Click="OcrCard_Click" />
                                <Button
                                    Grid.Column="3"
                                    Content="关闭"
                                    Padding="4,3"
                                    MinWidth="0"
                                    FontSize="11"
                                    AutomationProperties.Name="{x:Bind CloseCaption}"
                                    Click="CloseCard_Click" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel
                x:Name="EmptyPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock Text="还没有贴图" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock
                    Text="按 Alt + S 从剪贴板贴图，或从截图历史里贴一张。"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock
            Grid.Row="2"
            Text="单击卡片把贴图置顶并闪烁提示；锁定后仍可右键标注、裁剪、识别和另存为。点击穿透的贴图只能从这里恢复。"
            FontSize="11"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
    </Grid>
</Window>
