<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PrtScr.App.Views.OcrResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock
                x:Name="StatusText"
                FontSize="16"
                FontWeight="SemiBold"
                Text="识别完成"
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="EngineText" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <TextBox
            x:Name="TextOutput"
            Grid.Row="1"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            IsSpellCheckEnabled="False"
            AutomationProperties.Name="识别结果（可编辑）"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextChanged="TextOutput_TextChanged" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button
                x:Name="CopyButton"
                Content="复制全部文本"
                Click="Copy_Click"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}" />
            <Button Content="关闭" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
