<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PrtScr.App.Views.PinCropWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Black"
          PointerPressed="Root_PointerPressed"
          PointerMoved="Root_PointerMoved"
          PointerReleased="Root_PointerReleased">
        <Image x:Name="SourceImage" Stretch="Fill" IsHitTestVisible="False" />

        <Canvas x:Name="MaskLayer" IsHitTestVisible="False">
            <Rectangle x:Name="MaskAll" Fill="#66000000" />
            <Rectangle x:Name="MaskTop" Fill="#66000000" Visibility="Collapsed" />
            <Rectangle x:Name="MaskBottom" Fill="#66000000" Visibility="Collapsed" />
            <Rectangle x:Name="MaskLeft" Fill="#66000000" Visibility="Collapsed" />
            <Rectangle x:Name="MaskRight" Fill="#66000000" Visibility="Collapsed" />
        </Canvas>

        <Rectangle x:Name="SelectionBorder" Stroke="White" StrokeThickness="1.5"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Visibility="Collapsed" IsHitTestVisible="False" />

        <Border x:Name="MetaChip" Background="#E6202020" CornerRadius="3" Padding="6,3"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel Spacing="1">
                <TextBlock x:Name="MetaSize" FontSize="12" Foreground="White" />
                <TextBlock x:Name="MetaPixels" FontSize="10" Foreground="#FF9A9A9A" />
            </StackPanel>
        </Border>

        <Border x:Name="CenterHintPlate" Background="#8C000000" CornerRadius="4" Padding="12,6"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False">
            <TextBlock Text="拖拽框选要保留的区域" FontSize="15"
                       Foreground="#E6FFFFFF" />
        </Border>

        <Border x:Name="ActionBar" Background="#E6202020" CornerRadius="6" Padding="4"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,64"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="PinButton" Content="贴图" Click="Pin_Click"
                        Style="{StaticResource AccentButtonStyle}" Padding="12,4" FontSize="12"
                        MinWidth="0" CornerRadius="4" IsTabStop="False" />
                <Button x:Name="OcrButton" Content="识别" Click="Ocr_Click"
                        Background="#33FFFFFF" BorderBrush="#33FFFFFF" Foreground="White"
                        Padding="12,4" FontSize="12" MinWidth="0" CornerRadius="4" IsTabStop="False" />
                <Button x:Name="SaveButton" Content="保存" Click="Save_Click"
                        Background="#33FFFFFF" BorderBrush="#33FFFFFF" Foreground="White"
                        Padding="12,4" FontSize="12" MinWidth="0" CornerRadius="4" IsTabStop="False" />
            </StackPanel>
        </Border>

        <Border x:Name="HudBar" Background="#F2202020" CornerRadius="6" Padding="12,6"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Background="#33FFFFFF" BorderBrush="#59FFFFFF" BorderThickness="1"
                        CornerRadius="3" Padding="7,2">
                    <TextBlock Text="裁剪" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                </Border>
                <TextBlock x:Name="HudHintText" Text="拖拽 框选 · Esc / 右键 退出"
                           FontSize="12" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>