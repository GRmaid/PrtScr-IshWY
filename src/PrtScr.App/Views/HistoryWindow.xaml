<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PrtScr.App.Views.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PrtScr.App.Views">

    <Grid x:Name="RootGrid" Padding="18" RowSpacing="12" KeyboardAcceleratorPlacementMode="Hidden" PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Delete" Invoked="DeleteAccelerator_Invoked" />
            <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="截图历史" FontSize="20" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="12"
                    Opacity="0.6"
                    TextWrapping="Wrap"
                    Text="仅保存在本机 data\history。" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Opacity="0.62"
                    TextWrapping="Wrap"
                    Text="左键选中；右键进入多选，之后左键勾选/取消；点空白处或 Esc 退出。" />
            </StackPanel>
            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                MaxWidth="420"
                Opacity="0.65"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="CategoryList"
                SelectionMode="Single"
                SelectionChanged="CategoryList_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:HistoryCategoryView">
                        <Grid Margin="{x:Bind IndentMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind CountText}"
                                Margin="8,0,0,0"
                                FontSize="12"
                                Opacity="0.6" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Column="1">
                <GridView
                    x:Name="HistoryGrid"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="HistoryGrid_ItemClick"
                    SelectionChanged="HistoryGrid_SelectionChanged"
                    RightTapped="HistoryGrid_RightTapped"
                    DoubleTapped="HistoryGrid_DoubleTapped">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid
                                Orientation="Horizontal"
                                ItemWidth="224"
                                ItemHeight="200" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:HistoryItemView">
                            <Grid
                                Width="208"
                                Height="184"
                                Padding="8"
                                CornerRadius="8"
                                BorderThickness="{x:Bind CardBorderThickness, Mode=OneWay}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Image
                                    Source="{x:Bind Thumbnail}"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Row="1" Spacing="1">
                                    <TextBlock
                                        Text="{x:Bind Caption}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Detail}"
                                        FontSize="11"
                                        Opacity="0.6"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border
                                    Grid.RowSpan="2"
                                    Margin="-8"
                                    CornerRadius="8"
                                    Background="{x:Bind SelectionTintBrush, Mode=OneWay}"
                                    Visibility="{x:Bind SelectionVisibility, Mode=OneWay}"
                                    IsHitTestVisible="False" />
                                <Border
                                    Grid.RowSpan="2"
                                    Width="22"
                                    Height="22"
                                    CornerRadius="11"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-4,-4,0"
                                    Background="{x:Bind SelectionBadgeBrush, Mode=OneWay}"
                                    Visibility="{x:Bind SelectionVisibility, Mode=OneWay}"
                                    IsHitTestVisible="False">
                                    <FontIcon
                                        Glyph="&#xE73E;"
                                        FontSize="11"
                                        Foreground="White" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <TextBlock
                    x:Name="EmptyText"
                    Text="当前分类还没有截图。按截图热键截一张图，或检查“保存截图历史”是否已打开。"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    Visibility="Collapsed" />

                <ProgressRing
                    x:Name="LoadingRing"
                    Width="36"
                    Height="36"
                    IsActive="False"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="ActionHintText"
                FontSize="12"
                Opacity="0.62"
                TextTrimming="CharacterEllipsis"
                Text="选中截图后可复制、贴图、标注或另存为；多选时另存为会批量保存。" />

            <Grid x:Name="BottomBar" Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Content="复制"
                        Click="Copy_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="0"
                        Padding="10,6" />
                    <Button
                        Content="贴图"
                        Click="Pin_Click"
                        MinWidth="0"
                        Padding="10,6" />
                    <Button
                        Content="标注"
                        Click="Annotate_Click"
                        MinWidth="0"
                        Padding="10,6" />
                    <Button
                        Content="另存为"
                        Click="SaveAs_Click"
                        MinWidth="0"
                        Padding="10,6" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right">
                    <Border
                        Width="1"
                        Height="20"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button
                        Content="删除"
                        Click="Delete_Click"
                        MinWidth="0"
                        Padding="10,6" />
                    <Button
                        Content="清空分类"
                        Click="Clear_Click"
                        MinWidth="0"
                        Padding="10,6" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Border
                        Width="1"
                        Height="20"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button
                        x:Name="SelectAllButton"
                        Content="全选"
                        Click="SelectAll_Click"
                        MinWidth="0"
                        Padding="10,6" />
                    <Button
                        Content="打开文件夹"
                        Click="OpenFolder_Click"
                        MinWidth="0"
                        Padding="10,6" />
                    <Button
                        Content="关闭"
                        Click="Close_Click"
                        MinWidth="0"
                        Padding="10,6" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
