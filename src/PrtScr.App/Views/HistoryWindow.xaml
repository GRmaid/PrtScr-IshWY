<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PrtScr.App.Views.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PrtScr.App.Views">

    <Grid Padding="18" RowSpacing="12" PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="截图历史" FontSize="20" FontWeight="SemiBold" />
            <TextBlock
                x:Name="SubtitleText"
                FontSize="12"
                Opacity="0.6"
                TextWrapping="Wrap"
                Text="最近 30 张，仅保存在本机 data\history。" />
        </StackPanel>

        <Grid Grid.Row="1">
            <GridView
                x:Name="HistoryGrid"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="HistoryGrid_ItemClick"
                DoubleTapped="HistoryGrid_DoubleTapped">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            Orientation="Horizontal"
                            ItemWidth="224"
                            ItemHeight="192" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:HistoryItemView">
                        <Grid
                            Width="208"
                            Height="176"
                            Padding="8"
                            CornerRadius="8"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Image
                                Source="{x:Bind Thumbnail}"
                                Stretch="Uniform"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Row="1" Spacing="1">
                                <TextBlock
                                    Text="{x:Bind Caption}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind Detail}"
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <TextBlock
                x:Name="EmptyText"
                Text="还没有截图历史。按 F1 截一张图，或检查“保存截图历史”是否已打开。"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.6"
                Visibility="Collapsed" />

            <ProgressRing
                x:Name="LoadingRing"
                Width="36"
                Height="36"
                IsActive="False"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="复制" Click="Copy_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="贴图" Click="Pin_Click" />
                <Button Content="标注" Click="Annotate_Click" />
                <Button Content="另存为" Click="SaveAs_Click" />
                <Button Content="删除" Click="Delete_Click" />
                <Button Content="清空" Click="Clear_Click" />
                <Button Content="打开文件夹" Click="OpenFolder_Click" />
            </StackPanel>

            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Opacity="0.65"
                TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="2" Content="关闭" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
