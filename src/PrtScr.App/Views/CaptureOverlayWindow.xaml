<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PrtScr.App.Views.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="Root"
        Background="Black"
        PointerMoved="Layer_PointerMoved"
        PointerPressed="Layer_PointerPressed"
        PointerReleased="Layer_PointerReleased"
        PointerWheelChanged="Layer_PointerWheelChanged">
        <!-- 冻结的屏幕画面 -->
        <Image
            x:Name="Frozen"
            Stretch="Fill" />

        <!-- 交互层：遮罩 / 悬浮高亮 / 选区 / 尺寸提示 -->
        <Canvas
            x:Name="Layer"
            Background="Transparent">
            <Rectangle x:Name="MaskTop" Fill="#60000000" />
            <Rectangle x:Name="MaskLeft" Fill="#60000000" />
            <Rectangle x:Name="MaskRight" Fill="#60000000" />
            <Rectangle x:Name="MaskBottom" Fill="#60000000" />
            <Rectangle
                x:Name="HoverBorder"
                Stroke="#FF00C8FF"
                StrokeThickness="1.5" />
            <Rectangle
                x:Name="SelectionBorder"
                Stroke="#FFFFFFFF"
                StrokeThickness="1.5" />
            <Border
                x:Name="SizeTip"
                Background="#E6202020"
                CornerRadius="3"
                Padding="6,2">
                <TextBlock
                    x:Name="SizeText"
                    Foreground="White"
                    FontSize="12" />
            </Border>

            <!-- 模式徽标：取景器始终显示当前模式，Tab 随时切换 -->
            <Border
                x:Name="ModeBadge"
                Background="#E6202020"
                CornerRadius="3"
                Padding="8,3"
                IsHitTestVisible="False">
                <TextBlock
                    x:Name="ModeText"
                    Foreground="White"
                    FontSize="12" />
            </Border>
        </Canvas>

        <!-- 选区操作层：保存按钮浮在选区右上角，不遮挡取景交互 -->
        <Canvas x:Name="ActionLayer" Background="{x:Null}">
            <Button
                x:Name="SaveButton"
                Content="保存"
                Padding="12,4"
                FontSize="12"
                MinWidth="0"
                CornerRadius="4"
                IsTabStop="False"
                Visibility="Collapsed"
                Style="{StaticResource AccentButtonStyle}"
                Click="Save_Click" />

            <!-- 取色放大镜：跟随鼠标，19×19 像素放大 10 倍；无选区时才显示 -->
            <Border
                x:Name="LoupePanel"
                Background="#E6202020"
                CornerRadius="4"
                Padding="6"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                <StackPanel Spacing="4">
                    <Image
                        x:Name="LoupeImage"
                        Width="190"
                        Height="190"
                        Stretch="Fill" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            x:Name="LoupeHex"
                            Foreground="White"
                            FontSize="12"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="LoupeRgb"
                            Foreground="#FFB8B8B8"
                            FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 复制色值后的轻提示 -->
            <Border
                x:Name="CopyToast"
                Background="#E6202020"
                CornerRadius="3"
                Padding="10,4"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                <TextBlock
                    x:Name="CopyToastText"
                    Foreground="White"
                    FontSize="14" />
            </Border>
        </Canvas>

        <!-- 焦点锚：隐形按钮，亮窗即聚焦——Esc/回车/Tab 的 KeyDown 全部由它直达，不依赖焦点漂移 -->
        <Button
            x:Name="FocusSink"
            Width="1"
            Height="1"
            Opacity="0"
            IsTabStop="True"
            KeyDown="FocusSink_KeyDown" />

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
            <KeyboardAccelerator Key="Enter" Invoked="OnEnter" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveShortcut" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyColorShortcut" />
        </Grid.KeyboardAccelerators>
    </Grid>
</Window>