<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PrtScr.App.Views.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="Root"
        Background="Black"
        PointerMoved="Layer_PointerMoved"
        PointerPressed="Layer_PointerPressed"
        PointerReleased="Layer_PointerReleased"
        PointerWheelChanged="Layer_PointerWheelChanged">
        <!-- 冻结的屏幕画面 -->
        <Image
            x:Name="Frozen"
            Stretch="Fill" />

        <!-- 交互层：遮罩 / 悬浮高亮 / 选区 / 尺寸提示 -->
        <Canvas
            x:Name="Layer"
            Background="Transparent">
            <Rectangle x:Name="MaskTop" Fill="#60000000" />
            <Rectangle x:Name="MaskLeft" Fill="#60000000" />
            <Rectangle x:Name="MaskRight" Fill="#60000000" />
            <Rectangle x:Name="MaskBottom" Fill="#60000000" />
            <Rectangle
                x:Name="HoverBorder"
                Stroke="#FF00C8FF"
                StrokeThickness="1.5" />
            <Rectangle
                x:Name="SelectionBorder"
                Stroke="#FFFFFFFF"
                StrokeThickness="1.5" />
            <Border
                x:Name="SizeTip"
                Background="#E6202020"
                CornerRadius="3"
                Padding="6,2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock
                        x:Name="SizeText"
                        Foreground="White"
                        FontSize="12" />
                    <TextBlock
                        x:Name="ProcessText"
                        Foreground="#FF8FE3FF"
                        FontSize="12"
                        MaxWidth="220"
                        TextTrimming="CharacterEllipsis"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>

        </Canvas>

        <!-- 选区操作层：截图/识别/保存操作条 + 底部常驻 HUD，不遮挡取景交互 -->
        <Canvas x:Name="ActionLayer" Background="{x:Null}">
            <!-- 选区操作条：截图 / 识别 / 保存，优先浮在选区下方外侧 -->
            <Border
                x:Name="SelectionActions"
                Background="#E6202020"
                CornerRadius="6"
                Padding="4"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="CaptureButton"
                        Content="截图"
                        Padding="12,4"
                        FontSize="12"
                        MinWidth="0"
                        CornerRadius="4"
                        IsTabStop="False"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Capture_Click" />
                    <Button
                        x:Name="OcrButton"
                        Content="识别"
                        Padding="12,4"
                        FontSize="12"
                        MinWidth="0"
                        CornerRadius="4"
                        IsTabStop="False"
                        Background="#33FFFFFF"
                        BorderBrush="#33FFFFFF"
                        Foreground="White"
                        Click="Ocr_Click" />
                    <Button
                        x:Name="SaveButton"
                        Content="保存"
                        Padding="12,4"
                        FontSize="12"
                        MinWidth="0"
                        CornerRadius="4"
                        IsTabStop="False"
                        Background="#33FFFFFF"
                        BorderBrush="#33FFFFFF"
                        Foreground="White"
                        Click="Save_Click" />
                </StackPanel>
            </Border>

            <!-- 取色放大镜：跟随鼠标，19×19 像素放大 10 倍；无选区时才显示 -->
            <Border
                x:Name="LoupePanel"
                Background="#E6202020"
                CornerRadius="4"
                Padding="6"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                <StackPanel Spacing="4">
                    <Image
                        x:Name="LoupeImage"
                        Width="190"
                        Height="190"
                        Stretch="Fill" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            x:Name="LoupeHex"
                            Foreground="White"
                            FontSize="12"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="LoupeRgb"
                            Foreground="#FFB8B8B8"
                            FontSize="12" />
                    </StackPanel>
                    <TextBlock
                        Text="Ctrl+C 复制色值"
                        Foreground="#FF9A9A9A"
                        FontSize="11" />
                </StackPanel>
            </Border>

            <!-- 复制色值后的轻提示 -->
            <Border
                x:Name="CopyToast"
                Background="#E6202020"
                CornerRadius="3"
                Padding="10,4"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                <TextBlock
                    x:Name="CopyToastText"
                    Foreground="White"
                    FontSize="14" />
            </Border>

            <!-- 底部常驻 HUD：Tab 键帽 + 模式芯片 + 随状态变化的按键提示 -->
            <Border
                x:Name="HudBar"
                Background="#E6202020"
                CornerRadius="6"
                Padding="12,6"
                IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Tab 与当前模式同属一个色框，明确两者是同一组「按 Tab 切模式」语义 -->
                    <Border
                        Background="#3300C8FF"
                        BorderBrush="#5900C8FF"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="6,2">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock
                                Text="Tab"
                                Foreground="#FF8FE3FF"
                                FontSize="12"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="HudModeText"
                                Foreground="#FF8FE3FF"
                                FontSize="12"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock
                        x:Name="HudHintText"
                        Foreground="White"
                        FontSize="12"
                        VerticalAlignment="Center" />
                    <Border
                        Width="1"
                        Height="12"
                        Background="#33FFFFFF"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="右键 / Esc 退出"
                        Foreground="#FFB8B8B8"
                        FontSize="12"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Canvas>

        <!-- 焦点锚：隐形按钮，亮窗即聚焦——Esc/回车/Tab 的 KeyDown 全部由它直达，不依赖焦点漂移 -->
        <Button
            x:Name="FocusSink"
            Width="1"
            Height="1"
            Opacity="0"
            IsTabStop="True"
            KeyDown="FocusSink_KeyDown" />

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
            <KeyboardAccelerator Key="Enter" Invoked="OnEnter" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveShortcut" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyColorShortcut" />
        </Grid.KeyboardAccelerators>
    </Grid>
</Window>