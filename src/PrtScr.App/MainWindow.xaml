<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PrtScr.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <Grid>
        <Grid.Resources>
            <Style x:Key="ActionCardButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="112" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
            <Style x:Key="HintTextStyle" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.62" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <!-- 自定义背景层：设置里的背景图铺在最底下 -->
        <Image
            x:Name="BackgroundImage"
            Stretch="UniformToFill"
            Opacity="0.25" />

        <ScrollViewer>
            <StackPanel
                MaxWidth="760"
                Margin="28,24,28,48"
                Spacing="16">

                <StackPanel Spacing="2">
                    <TextBlock Text="实践小梅IshWY" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Ishmael is watching you · 分窗口截屏 · 窗口内容捕获 · 贴图 · OCR"
                        Opacity="0.6" />
                </StackPanel>

                <!-- 首页：四个高频动作 + 历史概览 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="常用操作" Style="{StaticResource SectionTitleStyle}" />
                    <Grid RowSpacing="10" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button
                            x:Name="ScreenshotActionButton"
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource ActionCardButtonStyle}"
                            Click="CaptureNow_Click">
                            <Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="窗口截图" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="抗遮挡抓窗口本体。&#10;滚轮选窗，回车截取。"
                                        MaxWidth="230"
                                        FontSize="12"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                                <Border
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Padding="8,3"
                                    CornerRadius="6"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <TextBlock
                                        x:Name="ScreenshotCardHotkey"
                                        FontFamily="Consolas"
                                        FontSize="12" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource ActionCardButtonStyle}"
                            Click="FullScreen_Click">
                            <Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="全屏截图" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="整张屏幕冻结后直接放进剪贴板。"
                                        MaxWidth="230"
                                        FontSize="12"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                                <Border
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Padding="8,3"
                                    CornerRadius="6"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <TextBlock
                                        x:Name="FullCardHotkey"
                                        FontFamily="Consolas"
                                        FontSize="12" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource ActionCardButtonStyle}"
                            Click="PastePin_Click">
                            <Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="贴图" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="把剪贴板里的图片钉在桌面上。"
                                        MaxWidth="230"
                                        FontSize="12"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                                <Border
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Padding="8,3"
                                    CornerRadius="6"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <TextBlock
                                        x:Name="PinCardHotkey"
                                        FontFamily="Consolas"
                                        FontSize="12" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource ActionCardButtonStyle}"
                            Click="OcrClipboard_Click">
                            <Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="文字识别" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="识别剪贴板图片里的文字。"
                                        MaxWidth="230"
                                        FontSize="12"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                                <Border
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Padding="8,3"
                                    CornerRadius="6"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <TextBlock
                                        x:Name="OcrCardHotkey"
                                        FontFamily="Consolas"
                                        FontSize="12" />
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>

                <Border
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="截图历史" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="HistoryHomeSummaryText"
                                Style="{StaticResource HintTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="打开历史" Click="OpenHistory_Click" />
                            <Button Content="贴图管理" Click="OpenPinManager_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock
                    x:Name="HomeStatusText"
                    Text="提示：截图热键随时可用；取景中按 Tab 切换模式，回车截取当前窗口。"
                    Style="{StaticResource HintTextStyle}" />

                <Expander Header="截图与热键" IsExpanded="True" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12" Margin="0,4">
                        <TextBlock Text="快捷键" Style="{StaticResource SectionTitleStyle}" />
                        <Border
                            Padding="12"
                            CornerRadius="10"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="操作" FontSize="12" Opacity="0.55" />
                                <TextBlock Grid.Column="1" Text="当前组合键" FontSize="12" Opacity="0.55" />
                                <TextBlock Grid.Column="2" Text="修改" FontSize="12" Opacity="0.55" />
                                <TextBlock Grid.Column="3" Text="删除" FontSize="12" Opacity="0.55" />

                                <TextBlock Grid.Row="1" Text="窗口截图" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="ScreenshotHotkeyText"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontFamily="Consolas"
                                    VerticalAlignment="Center" />
                                <Button
                                    x:Name="ScreenshotRecordButton"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    MinWidth="72"
                                    Content="修改"
                                    Tag="screenshot"
                                    Click="HotkeyRecord_Click"
                                    KeyDown="HotkeyRecord_KeyDown" />
                                <Button
                                    x:Name="ScreenshotClearButton"
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Width="28"
                                    Height="28"
                                    MinWidth="0"
                                    Padding="0"
                                    Content="✕"
                                    FontSize="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Tag="screenshot"
                                    Click="HotkeyClear_Click"
                                    ToolTipService.ToolTip="删除这个快捷键" />

                                <TextBlock Grid.Row="2" Text="全屏截图" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="FullHotkeyText"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    FontFamily="Consolas"
                                    VerticalAlignment="Center" />
                                <Button
                                    x:Name="FullHotkeyRecordButton"
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    MinWidth="72"
                                    Content="修改"
                                    Tag="fullscreen"
                                    Click="HotkeyRecord_Click"
                                    KeyDown="HotkeyRecord_KeyDown" />
                                <Button
                                    x:Name="FullHotkeyClearButton"
                                    Grid.Row="2"
                                    Grid.Column="3"
                                    Width="28"
                                    Height="28"
                                    MinWidth="0"
                                    Padding="0"
                                    Content="✕"
                                    FontSize="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Tag="fullscreen"
                                    Click="HotkeyClear_Click"
                                    ToolTipService.ToolTip="删除这个快捷键" />

                                <TextBlock Grid.Row="3" Text="贴图" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="PinHotkeyText"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    FontFamily="Consolas"
                                    VerticalAlignment="Center" />
                                <Button
                                    x:Name="PinHotkeyRecordButton"
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    MinWidth="72"
                                    Content="修改"
                                    Tag="pin"
                                    Click="HotkeyRecord_Click"
                                    KeyDown="HotkeyRecord_KeyDown" />
                                <Button
                                    x:Name="PinClearButton"
                                    Grid.Row="3"
                                    Grid.Column="3"
                                    Width="28"
                                    Height="28"
                                    MinWidth="0"
                                    Padding="0"
                                    Content="✕"
                                    FontSize="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Tag="pin"
                                    Click="HotkeyClear_Click"
                                    ToolTipService.ToolTip="删除这个快捷键" />

                                <TextBlock Grid.Row="4" Text="文字识别" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="OcrHotkeyText"
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    FontFamily="Consolas"
                                    VerticalAlignment="Center" />
                                <Button
                                    x:Name="OcrHotkeyRecordButton"
                                    Grid.Row="4"
                                    Grid.Column="2"
                                    MinWidth="72"
                                    Content="修改"
                                    Tag="ocr"
                                    Click="HotkeyRecord_Click"
                                    KeyDown="HotkeyRecord_KeyDown" />
                                <Button
                                    x:Name="OcrClearButton"
                                    Grid.Row="4"
                                    Grid.Column="3"
                                    Width="28"
                                    Height="28"
                                    MinWidth="0"
                                    Padding="0"
                                    Content="✕"
                                    FontSize="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Tag="ocr"
                                    Click="HotkeyClear_Click"
                                    ToolTipService.ToolTip="删除这个快捷键" />

                                <TextBlock Grid.Row="5" Text="切换截图模式" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="ModeHotkeyText"
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    FontFamily="Consolas"
                                    VerticalAlignment="Center" />
                                <Button
                                    x:Name="ModeHotkeyRecordButton"
                                    Grid.Row="5"
                                    Grid.Column="2"
                                    MinWidth="72"
                                    Content="修改"
                                    Tag="mode"
                                    Click="HotkeyRecord_Click"
                                    KeyDown="HotkeyRecord_KeyDown" />
                                <Button
                                    x:Name="ModeClearButton"
                                    Grid.Row="5"
                                    Grid.Column="3"
                                    Width="28"
                                    Height="28"
                                    MinWidth="0"
                                    Padding="0"
                                    Content="✕"
                                    FontSize="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Tag="mode"
                                    Click="HotkeyClear_Click"
                                    ToolTipService.ToolTip="删除这个快捷键" />
                            </Grid>
                        </Border>
                        <TextBlock
                            x:Name="HotkeyStatusText"
                            Style="{StaticResource HintTextStyle}" />
                        <TextBlock
                            Text="小叉叉删除当前快捷键；删除后仍可用首页按钮或托盘菜单，也可随时点「修改」重新录制。"
                            Style="{StaticResource HintTextStyle}" />

                        <TextBlock Text="完整快捷键目录" Style="{StaticResource SectionTitleStyle}" />
                        <Border
                            Padding="12"
                            CornerRadius="10"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <Grid ColumnSpacing="12" RowSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="范围" FontSize="12" Opacity="0.55" />
                                <TextBlock Grid.Column="1" Text="按键" FontSize="12" Opacity="0.55" />
                                <TextBlock Grid.Column="2" Text="动作" FontSize="12" Opacity="0.55" />

                                <TextBlock Grid.Row="1" Text="取景器" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Tab" FontFamily="Consolas" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="在窗口截图与常规截图之间切换" />

                                <TextBlock Grid.Row="2" Grid.Column="1" Text="滚轮 / 回车" FontFamily="Consolas" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="切换窗口候选 / 直接截取当前窗口" />

                                <TextBlock Grid.Row="3" Grid.Column="1" Text="O / Ctrl+S" FontFamily="Consolas" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="识别选区文字 / 选区另存为" />

                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Ctrl+C" FontFamily="Consolas" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="无选区复制指针色值；有选区复制图片" />

                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Esc / 鼠标右键" FontFamily="Consolas" />
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="取消取景（始终可用，不可改键）" />

                                <TextBlock Grid.Row="6" Text="贴图 / 裁剪" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="Ctrl+Z / Ctrl+S" FontFamily="Consolas" />
                                <TextBlock Grid.Row="6" Grid.Column="2" Text="撤销标注 / 另存为" />

                                <TextBlock Grid.Row="7" Grid.Column="1" Text="回车 / Esc" FontFamily="Consolas" />
                                <TextBlock Grid.Row="7" Grid.Column="2" Text="完成标注或裁剪贴图 / 退出当前状态" />

                                <TextBlock Grid.Row="8" Text="截图历史" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="双击 / 右键 / Ctrl+A / Delete" FontFamily="Consolas" />
                                <TextBlock Grid.Row="8" Grid.Column="2" Text="直接贴图 / 进入多选 / 全选 / 删除选中" />

                                <TextBlock Grid.Row="9" Grid.Column="1" Text="Esc" FontFamily="Consolas" />
                                <TextBlock Grid.Row="9" Grid.Column="2" Text="先退出多选；再按一次关闭历史窗" />
                            </Grid>
                        </Border>
                        <TextBlock
                            Text="全局组合键可在上表修改；取景器与贴图内的按键是固定语义，Esc 与鼠标右键始终作为兜底退出。"
                            Style="{StaticResource HintTextStyle}" />

                        <TextBlock Text="截图行为" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="截图热键行为" />
                            <ComboBox
                                x:Name="CaptureProfileCombo"
                                Width="390"
                                SelectionChanged="CaptureProfileCombo_SelectionChanged">
                                <ComboBoxItem Content="常规取景（冻屏后框选 / 选窗）" Tag="normal" />
                                <ComboBoxItem Content="快捷全屏（直接复制到剪贴板）" Tag="quick" />
                            </ComboBox>
                            <TextBlock x:Name="CaptureProfileHintText" Style="{StaticResource HintTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <StackPanel Spacing="4">
                                <TextBlock Text="延时截图" />
                                <ComboBox
                                    x:Name="DelayCombo"
                                    Width="170"
                                    SelectionChanged="DelayCombo_SelectionChanged">
                                    <ComboBoxItem Content="不延时" Tag="0" />
                                    <ComboBoxItem Content="3 秒" Tag="3" />
                                    <ComboBoxItem Content="5 秒" Tag="5" />
                                    <ComboBoxItem Content="10 秒" Tag="10" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="常规取景起始模式" />
                                <ComboBox
                                    x:Name="DefaultModeCombo"
                                    Width="390"
                                    SelectionChanged="DefaultModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="窗口截图（抗遮挡，抓窗口本体）" Tag="window" />
                                    <ComboBoxItem Content="常规截图（所见即所得，可抓菜单/光标）" Tag="normal" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="CaptureCursorToggle"
                            Header="截图包含鼠标指针（F1 取景和全屏截图都生效）"
                            Toggled="CaptureCursorToggle_Toggled" />
                        <TextBlock x:Name="CaptureModeHintText" Style="{StaticResource HintTextStyle}" />
                        <TextBlock x:Name="CaptureOptionsText" Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </Expander>

                <Expander Header="贴图" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="10" Margin="0,4">
                        <TextBlock
                            Text="新贴图初始大小（原图 80–100%）"
                            TextWrapping="Wrap" />
                        <NumberBox
                            x:Name="PinInitialScaleBox"
                            Width="220"
                            HorizontalAlignment="Left"
                            Minimum="80"
                            Maximum="100"
                            SmallChange="5"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="PinInitialScale_ValueChanged" />
                        <TextBlock x:Name="PinInitialScaleHintText" Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </Expander>

                <Expander Header="截图历史" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="10" Margin="0,4">
                        <ToggleSwitch
                            x:Name="HistoryToggle"
                            Header="保存截图到本机（data\history，按模式 / 进程分类）"
                            Toggled="HistoryToggle_Toggled" />
                        <TextBlock
                            Text="每个分类保留张数（窗口截图按进程各算一类；常规截图、早期未分类各算一类）"
                            TextWrapping="Wrap" />
                        <NumberBox
                            x:Name="HistoryLimitBox"
                            Width="220"
                            HorizontalAlignment="Left"
                            Minimum="1"
                            Maximum="200"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="HistoryLimit_ValueChanged" />
                        <ToggleSwitch
                            x:Name="HistoryPinCropToggle"
                            Header="贴图裁剪结果也写入历史（分类：贴图裁剪）"
                            Toggled="HistoryPinCropToggle_Toggled" />
                        <TextBlock x:Name="HistoryStatusText" Style="{StaticResource HintTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="打开截图历史" Click="OpenHistory_Click" />
                            <Button Content="清空历史" Click="ClearHistory_Click" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander Header="启动与托盘" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="10" Margin="0,4">
                        <ToggleSwitch
                            x:Name="StartupToggle"
                            Header="开机自动启动（登录 Windows 后静默运行到托盘）"
                            Toggled="StartupToggle_Toggled" />
                        <TextBlock x:Name="StartupStatusText" Style="{StaticResource HintTextStyle}" />
                        <TextBlock
                            Text="关闭窗口只会收进托盘；要彻底退出，请用托盘右键菜单里的「退出」。"
                            Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </Expander>

                <Expander Header="外观 · 自定义背景" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="10" Margin="0,4">
                        <TextBlock
                            Text="给界面换一张喜欢的背景图（背景图与不透明度会保存，重启后依然生效）。"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="选择背景图片…" Click="PickBackground_Click" />
                            <Button Content="恢复默认" Click="ClearBackground_Click" />
                        </StackPanel>
                        <Slider
                            x:Name="BackgroundOpacitySlider"
                            Header="背景不透明度"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.05"
                            Width="260"
                            HorizontalAlignment="Left"
                            ValueChanged="BackgroundOpacity_ValueChanged" />
                    </StackPanel>
                </Expander>

                <Expander Header="OCR 引擎" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8" Margin="0,4">
                        <ToggleSwitch
                            x:Name="OcrPreferUmiToggle"
                            Header="优先使用 Umi-OCR（需本机在线；不在线自动回退 Windows OCR）"
                            Toggled="OcrPreferUmi_Toggled" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <NumberBox
                                x:Name="UmiPortBox"
                                Header="Umi-OCR 端口"
                                Minimum="1"
                                Maximum="65535"
                                SpinButtonPlacementMode="Inline"
                                Width="160"
                                ValueChanged="UmiPort_ValueChanged" />
                            <Button
                                Content="测试 Umi-OCR 连接"
                                Click="TestUmi_Click"
                                VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock
                            x:Name="OcrStatusText"
                            Text="检测中…"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="Windows OCR 为内置默认、零依赖，但中文精度一般；Umi-OCR（PaddleOCR）精度更高，属于可选引擎——检测到本机 1224 端口在线才会启用，没安装则自动跳过。"
                            Opacity="0.6"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander Header="关于" HorizontalAlignment="Stretch">
                    <TextBlock
                        x:Name="AboutText"
                        Margin="0,4"
                        TextWrapping="Wrap" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- 托盘图标 -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="实践小梅IshWY — 截图工具"
            ContextMenuMode="SecondWindow"
            IconSource="ms-appx:///Assets/app.ico">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout x:Name="TrayMenu">
                    <MenuFlyoutItem Text="设置" Click="ShowSettings_Click" />
                    <MenuFlyoutItem Text="从剪贴板贴图" Click="PastePin_Click" />
                    <MenuFlyoutItem Text="从剪贴板识别文字" Click="OcrClipboard_Click" />
                    <MenuFlyoutItem Text="全屏截图到剪贴板" Click="FullScreen_Click" />
                    <MenuFlyoutItem x:Name="DelayCaptureItem" Text="延时截图" Click="DelayCapture_Click" />
                    <MenuFlyoutItem x:Name="CancelDelayItem" Text="取消延时截图" Click="CancelDelay_Click" Visibility="Collapsed" />
                    <MenuFlyoutItem Text="截图历史…" Click="History_Click" />
                    <MenuFlyoutItem Text="贴图管理…" Click="OpenPinManager_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="退出" Click="Exit_Click" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
