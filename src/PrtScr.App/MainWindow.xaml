<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PrtScr.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <Grid>
        <!-- 自定义背景层：设置里的背景图铺在最底下 -->
        <Image
            x:Name="BackgroundImage"
            Stretch="UniformToFill"
            Opacity="0.25" />

        <ScrollViewer>
            <StackPanel
                MaxWidth="760"
                Margin="28,24,28,48"
                Spacing="14">

                <TextBlock Text="实践小梅IshWY" FontSize="32" FontWeight="SemiBold" />
                <TextBlock
                    Text="Ishmael is watching you · 分窗口截屏 · 窗口内容捕获 · 贴图 · OCR"
                    Opacity="0.6" />

                <Expander Header="常规" IsExpanded="True" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="10" Margin="0,4">
                        <ToggleSwitch
                            x:Name="StartupToggle"
                            Header="开机自动启动（登录 Windows 后静默运行到托盘）"
                            Toggled="StartupToggle_Toggled" />
                        <TextBlock
                            x:Name="StartupStatusText"
                            Opacity="0.6"
                            TextWrapping="Wrap" />
                        <TextBlock Text="窗口截图热键（默认 F1；取景中按 Tab 切换窗口/常规截图；支持任意组合键，F1–F12 可单独使用）" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ScreenshotRecordButton"
                                Tag="screenshot"
                                Content="点击录制组合键…"
                                Click="HotkeyRecord_Click"
                                KeyDown="HotkeyRecord_KeyDown" />
                            <TextBlock
                                x:Name="ScreenshotHotkeyText"
                                VerticalAlignment="Center"
                                Opacity="0.7" />
                        </StackPanel>
                        <TextBlock
                            x:Name="HotkeyStatusText"
                            Opacity="0.6"
                            TextWrapping="Wrap" />
                        <TextBlock Text="全屏快速截图热键（按下即把当前屏幕整张复制到剪贴板）" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="FullHotkeyRecordButton"
                                Tag="fullscreen"
                                Content="点击录制组合键…"
                                Click="HotkeyRecord_Click"
                                KeyDown="HotkeyRecord_KeyDown" />
                            <TextBlock
                                x:Name="FullHotkeyText"
                                VerticalAlignment="Center"
                                Opacity="0.7" />
                        </StackPanel>
                        <TextBlock Text="贴图热键（从剪贴板取图钉在桌面；默认 Ctrl+Alt+V）" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="PinHotkeyRecordButton"
                                Tag="pin"
                                Content="点击录制组合键…"
                                Click="HotkeyRecord_Click"
                                KeyDown="HotkeyRecord_KeyDown" />
                            <TextBlock
                                x:Name="PinHotkeyText"
                                VerticalAlignment="Center"
                                Opacity="0.7" />
                        </StackPanel>
                        <TextBlock Text="OCR 热键（识别剪贴板图片里的文字；默认 Ctrl+Alt+S）" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="OcrHotkeyRecordButton"
                                Tag="ocr"
                                Content="点击录制组合键…"
                                Click="HotkeyRecord_Click"
                                KeyDown="HotkeyRecord_KeyDown" />
                            <TextBlock
                                x:Name="OcrHotkeyText"
                                VerticalAlignment="Center"
                                Opacity="0.7" />
                        </StackPanel>
                        <TextBlock
                            Text="延时截图（按下截图热键后先等待，再冻结画面；方便打开右键菜单、悬停提示、下拉框）"
                            Margin="0,6,0,0"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="DelayCombo"
                            Width="150"
                            HorizontalAlignment="Left"
                            SelectionChanged="DelayCombo_SelectionChanged">
                            <ComboBoxItem Content="不延时" Tag="0" />
                            <ComboBoxItem Content="3 秒" Tag="3" />
                            <ComboBoxItem Content="5 秒" Tag="5" />
                            <ComboBoxItem Content="10 秒" Tag="10" />
                        </ComboBox>
                        <ToggleSwitch
                            x:Name="CaptureCursorToggle"
                            Header="截图包含鼠标指针（F1 取景和全屏截图都生效）"
                            Toggled="CaptureCursorToggle_Toggled" />
                        <TextBlock
                            Text="默认截图模式（每次按截图热键从该模式起步；取景中按 Tab 临时切换，切换会清除已有选区）"
                            Margin="0,6,0,0"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="DefaultModeCombo"
                            Width="360"
                            HorizontalAlignment="Left"
                            SelectionChanged="DefaultModeCombo_SelectionChanged">
                            <ComboBoxItem Content="窗口截图（抗遮挡，抓窗口本体；适合被别的窗口盖住时）" Tag="window" />
                            <ComboBoxItem Content="常规截图（所见即所得，能抓菜单/悬停/光标）" Tag="normal" />
                        </ComboBox>
                        <TextBlock
                            x:Name="CaptureModeHintText"
                            Opacity="0.6"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="CaptureOptionsText"
                            Opacity="0.6"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="从剪贴板贴图" Click="PastePin_Click" />
                            <Button Content="从剪贴板识别文字" Click="OcrClipboard_Click" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="HistoryToggle"
                            Header="保存最近截图到本机（data\history，按模式 / 进程分类）"
                            Margin="0,4,0,0"
                            Toggled="HistoryToggle_Toggled" />
                        <TextBlock
                            Text="每个分类保留张数（窗口截图按进程各算一类；常规截图、早期未分类各算一类）"
                            TextWrapping="Wrap" />
                        <NumberBox
                            x:Name="HistoryLimitBox"
                            Width="220"
                            HorizontalAlignment="Left"
                            Minimum="1"
                            Maximum="200"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="HistoryLimit_ValueChanged" />
                        <TextBlock
                            x:Name="HistoryStatusText"
                            Opacity="0.6"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="打开截图历史" Click="OpenHistory_Click" />
                            <Button Content="清空历史" Click="ClearHistory_Click" />
                        </StackPanel>
                        <TextBlock
                            Text="提示：取景中框选后按 O 可直接识别文字；贴图右键菜单也有「识别文字」；托盘右键菜单可识别剪贴板图片。"
                            Opacity="0.6"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander Header="外观 · 自定义背景" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="10" Margin="0,4">
                        <TextBlock
                            Text="给界面换一张喜欢的背景图（背景图与不透明度会保存，重启后依然生效）。"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="选择背景图片…" Click="PickBackground_Click" />
                            <Button Content="恢复默认" Click="ClearBackground_Click" />
                        </StackPanel>
                        <Slider
                            x:Name="BackgroundOpacitySlider"
                            Header="背景不透明度"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.05"
                            Width="260"
                            HorizontalAlignment="Left"
                            ValueChanged="BackgroundOpacity_ValueChanged" />
                    </StackPanel>
                </Expander>

                <Expander Header="OCR 引擎" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8" Margin="0,4">
                        <ToggleSwitch
                            x:Name="OcrPreferUmiToggle"
                            Header="优先使用 Umi-OCR（需本机在线；不在线自动回退 Windows OCR）"
                            Toggled="OcrPreferUmi_Toggled" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <NumberBox
                                x:Name="UmiPortBox"
                                Header="Umi-OCR 端口"
                                Minimum="1"
                                Maximum="65535"
                                SpinButtonPlacementMode="Inline"
                                Width="160"
                                ValueChanged="UmiPort_ValueChanged" />
                            <Button
                                Content="测试 Umi-OCR 连接"
                                Click="TestUmi_Click"
                                VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock
                            x:Name="OcrStatusText"
                            Text="检测中…"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="Windows OCR 为内置默认、零依赖，但中文精度一般；Umi-OCR（PaddleOCR）精度更高，属于可选引擎——检测到本机 1224 端口在线才会启用，没安装则自动跳过。"
                            Opacity="0.6"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander Header="关于" HorizontalAlignment="Stretch">
                    <TextBlock
                        x:Name="AboutText"
                        Margin="0,4"
                        TextWrapping="Wrap" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- 托盘图标 -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="实践小梅IshWY — 截图工具"
            ContextMenuMode="SecondWindow"
            IconSource="ms-appx:///Assets/app.ico">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout x:Name="TrayMenu">
                    <MenuFlyoutItem Text="设置" Click="ShowSettings_Click" />
                    <MenuFlyoutItem Text="从剪贴板贴图" Click="PastePin_Click" />
                    <MenuFlyoutItem Text="从剪贴板识别文字" Click="OcrClipboard_Click" />
                    <MenuFlyoutItem Text="全屏截图到剪贴板" Click="FullScreen_Click" />
                    <MenuFlyoutItem x:Name="DelayCaptureItem" Text="延时截图" Click="DelayCapture_Click" />
                    <MenuFlyoutItem x:Name="CancelDelayItem" Text="取消延时截图" Click="CancelDelay_Click" Visibility="Collapsed" />
                    <MenuFlyoutItem Text="截图历史…" Click="History_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="退出" Click="Exit_Click" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>